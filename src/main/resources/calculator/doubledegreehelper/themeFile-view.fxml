<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Text?>

<TabPane prefHeight="400.0" prefWidth="600.0" tabClosingPolicy="UNAVAILABLE" xmlns:fx="http://javafx.com/fxml/1" xmlns="http://javafx.com/javafx/21" fx:controller="calculator.doubledegreehelper.controller.themeFileController">
    <tabs>
        <Tab text="Thema">
            <content>
                <AnchorPane prefHeight="400.0" prefWidth="600.0">
                    <children>

                        <!-- Datei-Auswahl mittig im AnchorPane (horizontal und vertikal) -->
                        <VBox alignment="CENTER" spacing="10.0" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
                            <children>
                                <Text fx:id="instructionText" text="Wählen Sie die Themenliste aus (.xlsx)" />
                                <HBox alignment="CENTER" spacing="10.0">
                                    <children>
                                        <Button fx:id="fileChooserButton" minHeight="25.0" minWidth="125.0" mnemonicParsing="false" text="Auswählen" />
                                    </children>
                                </HBox>
                        <ImageView fitHeight="41.0" fitWidth="43.0" pickOnBounds="true" preserveRatio="true">
                           <image>
                              <Image url="@../themeIcon.png" />
                           </image>
                        </ImageView>
                            </children>
                        </VBox>

                        <!-- Navigations-Buttons unten -->
                        <HBox alignment="CENTER_LEFT" spacing="10.0" AnchorPane.bottomAnchor="20.0" AnchorPane.leftAnchor="20.0" AnchorPane.rightAnchor="20.0">
                            <children>
                                <Button fx:id="backButton" mnemonicParsing="false" text="Zurück" />
                                <Region HBox.hgrow="ALWAYS" />
                                <Button fx:id="continueButton" mnemonicParsing="false" text="Weiter" />
                            </children>
                        </HBox>

                    </children>
                </AnchorPane>
            </content>
        </Tab>
    </tabs>
</TabPane>
